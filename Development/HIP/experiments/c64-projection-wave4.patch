+  #pragma unroll
+  for(uint j=0;j<4;j++){uint off=3*C*C+((col+j*16+rc)*C+k+gr*8)/4;i2 b={int(pw[off]),int(pw[off+1])};acc[j]=__builtin_amdgcn_wmma_f32_16x16x16_fp8_fp8_w32_gfx12(a,b,acc[j]);}}
+ for(uint j=0;j<4;j++)for(uint e=0;e<8;e++){uint p=first+gr*8+e,n=col+j*16+rc;if(p>=M)continue;uint dest=p*C+n;if(cropw){uint x=p%workw,y=p/workw;if(x<sx||y<sy||x>=sx+cropw||y>=sy+croph)continue;dest=((y-sy)*cropw+x-sx)*C+n;}out[dest]=post==3?Hrtz(acc[j][e]):post==0?F(Hrtz(acc[j][e])):F(acc[j][e]);}

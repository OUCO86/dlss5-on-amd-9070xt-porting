#include <windows.h>
#include <cstdio>
#include "Development/HIP/hip_reference_network.h"

std::vector<float> read(const char* path) {
 auto b=hip_reference::ReadBytes(path);
 if(b.size()%4)throw std::runtime_error("unaligned input");
 std::vector<float> v(b.size()/4);memcpy(v.data(),b.data(),b.size());return v;
}
int main(int argc,char**argv){try{
 if(argc!=10)throw std::runtime_error("assets modules flags input expected width height frames repeats");
 unsigned W=unsigned(std::stoul(argv[6])),H=unsigned(std::stoul(argv[7]));
 unsigned frames=unsigned(std::stoul(argv[8])),repeats=unsigned(std::stoul(argv[9]));
 if(!frames||!repeats)throw std::runtime_error("positive frames/repeats required");
 std::ifstream flags(argv[3]);if(!flags)throw std::runtime_error("flags missing");
 std::string line;while(std::getline(flags,line)){
  if(!line.empty()&&line.back()=='\r')line.pop_back();auto eq=line.find('=');
  if(line.rfind("DLSS5_",0)==0&&eq!=std::string::npos)_putenv_s(line.substr(0,eq).c_str(),line.substr(eq+1).c_str());
 }
 _putenv_s("DLSS5_HIP_FAST","1");_putenv_s("DLSS5_HIP_PDL","1");
 _putenv_s("DLSS5_HIP_GRAPH","0");_putenv_s("DLSS5_VIT_ADAPTIVE","0");
 _putenv_s("DLSS5_VIT_REUSE_HOTKEY","0");_putenv_s("DLSS5_HIP_DUP_PREFIX","");
 /* OPTIONS */
 o.modules=argv[2];hip_reference::Network net(o);auto&api=net.Runtime();
 auto input=read(argv[4]),expected=read(argv[5]);
 if(input.size()!=size_t(W)*H*4||expected.size()!=size_t(W)*H*3)throw std::runtime_error("shape");
 void*x{},*y{};api.Check(api.hipMalloc(&x,input.size()*4),"input");api.Check(api.hipMalloc(&y,expected.size()*4),"output");
 api.Check(api.hipMemcpy(x,input.data(),input.size()*4,1),"upload");
 auto run=[&](){net.Enqueue(x,nullptr,y,0);net.Synchronize();};
 auto verify=[&](){std::vector<float>actual(expected.size());api.Check(api.hipMemcpy(actual.data(),y,actual.size()*4,2),"readback");
  size_t bad=0;for(size_t i=0;i<actual.size();i++)bad+=memcmp(&actual[i],&expected[i],4)!=0||!std::isfinite(actual[i]);
  printf("VERIFY bitdiff=%llu\n",(unsigned long long)bad);fflush(stdout);if(bad)throw std::runtime_error("output mismatch");};
 FILE*f=fopen("slots.csv","wb");if(!f)throw std::runtime_error("slots.csv");
 fprintf(f,"repeat,candidate,slot,mode,frames,ms,post_calls,pdl_calls\n");
 std::vector<unsigned> candidates{1u,2u,3u,4u};
 if(const char*env=std::getenv("POST_INPUT_CANDIDATES")){
  candidates.clear();std::string list=env;size_t p=0;
  while(p<list.size()){size_t e=list.find(',',p);if(e==std::string::npos)e=list.size();unsigned m=unsigned(std::stoul(list.substr(p,e-p)));if(m<1||m>4)throw std::runtime_error("candidate must be 1..4");candidates.push_back(m);p=e+1;}
  if(candidates.empty())throw std::runtime_error("empty candidates");
 }
 for(unsigned rep=0;rep<repeats;rep++)for(unsigned candidate:candidates){
  unsigned order[]={0,candidate,candidate,0};
  for(unsigned slot=0;slot<4;slot++){
   unsigned mode=order[slot];net.SetPostMode(mode);
   for(unsigned i=0;i<20;i++)run();verify();
   unsigned before=net.PostCalls();auto begin=std::chrono::steady_clock::now();
   for(unsigned i=0;i<frames;i++)run();
   double ms=std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-begin).count()/frames;
   unsigned calls=net.PostCalls()-before;verify();
   if(calls!=frames)throw std::runtime_error("post must execute exactly once per frame");
   fprintf(f,"%u,%u,%u,%u,%u,%.9f,%u,%u\n",rep,candidate,slot,mode,frames,ms,calls,net.PdlCalls());fflush(f);
   printf("SLOT repeat=%u candidate=%u slot=%u mode=%u ms=%.6f calls=%u\n",rep,candidate,slot,mode,ms,calls);fflush(stdout);
  }
 }
 fclose(f);api.hipFree(x);api.hipFree(y);puts("PASS post input controls");return 0;
}catch(const std::exception&e){fprintf(stderr,"FAIL %s\n",e.what());return 1;}}

#include <windows.h>
#include <cstdio>
#include "Development/HIP/hip_reference_network.h"
std::vector<float> read(const char*p){auto b=hip_reference::ReadBytes(p);if(b.size()%4)throw std::runtime_error("alignment");std::vector<float>v(b.size()/4);memcpy(v.data(),b.data(),b.size());return v;}
int main(int argc,char**argv){try{
 if(argc!=10)throw std::runtime_error("assets modules flags input expected width height frames repeats");
 unsigned W=std::stoul(argv[6]),H=std::stoul(argv[7]),frames=std::stoul(argv[8]),repeats=std::stoul(argv[9]);
 std::ifstream flags(argv[3]);if(!flags)throw std::runtime_error("flags");std::string line;
 while(std::getline(flags,line)){if(!line.empty()&&line.back()=='\r')line.pop_back();auto q=line.find('=');if(line.rfind("DLSS5_",0)==0&&q!=std::string::npos)_putenv_s(line.substr(0,q).c_str(),line.substr(q+1).c_str());}
 _putenv_s("DLSS5_HIP_FAST","1");_putenv_s("DLSS5_HIP_PDL","1");_putenv_s("DLSS5_HIP_GRAPH","0");_putenv_s("DLSS5_VIT_ADAPTIVE","0");_putenv_s("DLSS5_VIT_REUSE_HOTKEY","0");_putenv_s("DLSS5_HIP_DUP_PREFIX","");
 /* OPTIONS */
 o.modules=argv[2];hip_reference::Network net(o);auto&api=net.Runtime();
 auto input=read(argv[4]),expected=read(argv[5]);if(input.size()!=size_t(W)*H*4||expected.size()!=size_t(W)*H*3)throw std::runtime_error("shape");
 void*x{},*y{};api.Check(api.hipMalloc(&x,input.size()*4),"input");api.Check(api.hipMalloc(&y,expected.size()*4),"output");api.Check(api.hipMemcpy(x,input.data(),input.size()*4,1),"upload");
 auto run=[&](){net.Enqueue(x,nullptr,y,0);net.Synchronize();};
 auto verify=[&](){std::vector<float>v(expected.size());api.Check(api.hipMemcpy(v.data(),y,v.size()*4,2),"check");size_t bad=0,invalid=0,first=expected.size();double mse=0,maxerr=0;
  for(size_t i=0;i<v.size();i++){bool different=memcmp(&v[i],&expected[i],4)!=0;bad+=different;if(different&&first==expected.size())first=i;invalid+=!std::isfinite(v[i]);double e=double(v[i])-expected[i];mse+=e*e;maxerr=std::max(maxerr,std::abs(e));}
  printf("VERIFY bitdiff=%llu invalid=%llu max=%.9g rmse=%.9g first=%llu actual=%.9g expected=%.9g\n",(unsigned long long)bad,(unsigned long long)invalid,maxerr,sqrt(mse/v.size()),(unsigned long long)first,first<v.size()?v[first]:0,first<v.size()?expected[first]:0);fflush(stdout);
  if(bad||invalid)throw std::runtime_error("output mismatch");};
 FILE*f=fopen("slots.csv","wb");if(!f)throw std::runtime_error("slots");fprintf(f,"repeat,slot,mode,frames,ms,c64_calls\n");
 for(unsigned rep=0;rep<repeats;rep++){unsigned order[]={0,1,1,0};for(unsigned slot=0;slot<4;slot++){
  net.W2Mode(order[slot]);run();verify();for(unsigned i=0;i<20;i++)run();
  unsigned calls=net.W2Calls();auto begin=std::chrono::steady_clock::now();for(unsigned i=0;i<frames;i++)run();double ms=std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-begin).count()/frames;
  calls=net.W2Calls()-calls;verify();if(calls!=frames*8)throw std::runtime_error("C64 call count");
  fprintf(f,"%u,%u,%u,%u,%.9f,%u\n",rep,slot,order[slot],frames,ms,calls);fflush(f);printf("SLOT repeat=%u slot=%u mode=%u ms=%.6f calls=%u\n",rep,slot,order[slot],ms,calls);fflush(stdout);
 }}
 fclose(f);api.hipFree(x);api.hipFree(y);puts("PASS C64 two-wave");return 0;
}catch(const std::exception&e){fprintf(stderr,"FAIL %s\n",e.what());return 1;}}
